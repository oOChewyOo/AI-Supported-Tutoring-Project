# Public project credentials for Supabase Auth + RLS. Never use a service-role/secret key.
# Apply the reviewed auth migration and provision tutors first; see docs/tutor-auth-security.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Development preview only; both variables must stay server-only.
RESOURCE_STUDIO_BASE_URL=http://localhost:3001
PRACTICE_LOOP_INTEGRATION_KEY=
